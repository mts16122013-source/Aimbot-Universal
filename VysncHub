local function cd(class, props)
    local d = Drawing.new(class)
    for k,v in pairs(props) do d[k]=v end
    return d
end

function K.remove_esp(player)
    local obj = esp_objects[player]
    if not obj then return end
    for _,v in pairs(obj) do
        if typeof(v)=="table" then
            for _,l in ipairs(v) do l:Remove() end
        elseif v.Remove then v:Remove() end
    end
    esp_objects[player]=nil
end

function K.remove_all_esp()
    for player in pairs(esp_objects) do K.remove_esp(player) end
end

function K.cleanup_drawings()
    K.remove_all_esp()
    if K.fov_circle then K.fov_circle:Remove() K.fov_circle = nil end
    if K.car_text then K.car_text:Remove() K.car_text = nil end
end

