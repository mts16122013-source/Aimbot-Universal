local spin_av=nil
local orig_lighting=nil

function K.restore_anims()
    local c=LocalPlayer.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local an=h:FindFirstChildOfClass("Animator")
    if not an then return end
    for _,t in ipairs(an:GetPlayingAnimationTracks()) do
        if t.Speed==0 then t:AdjustSpeed(1) end
    end
end

function K.update_misc(dt)
    local c=LocalPlayer.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    
    K.update_car()

    if cfg.freeze_anims and h then
        local an=h:FindFirstChildOfClass("Animator")
        if an then
            for _,t in ipairs(an:GetPlayingAnimationTracks()) do
                if t.Speed~=0 then t:AdjustSpeed(0) end
            end
        end
    end
    if cfg.fullbright then
        if not orig_lighting then
            orig_lighting={A=Lighting.Ambient,O=Lighting.OutdoorAmbient,B=Lighting.Brightness,F=Lighting.FogEnd}
        end
        Lighting.Ambient=Color3.new(1,1,1)
        Lighting.OutdoorAmbient=Color3.new(1,1,1)
        Lighting.Brightness=3
        Lighting.FogEnd=100000
    elseif orig_lighting then
        Lighting.Ambient=orig_lighting.A
        Lighting.OutdoorAmbient=orig_lighting.O
        Lighting.Brightness=orig_lighting.B
        Lighting.FogEnd=orig_lighting.F
        orig_lighting=nil
    end
    if not hrp or not cfg.spinbot then
        if spin_av then spin_av:Destroy() spin_av=nil end
        return
    end
    if not spin_av or spin_av.Parent~=hrp then
        if spin_av then spin_av:Destroy() end
        spin_av=Instance.new("BodyAngularVelocity")
        spin_av.Name="KarpaSpin"
        spin_av.MaxTorque=Vector3.new(0,1e5,0)
        spin_av.P=1000
        spin_av.Parent=hrp
    end
    local spd=math.min(cfg.spin_speed,2000)
    spin_av.AngularVelocity=Vector3.new(0,math.rad(spd),0)
end

