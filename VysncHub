local function vis(part)
    if not cfg.visible_check then return true end
    local o=Camera.CFrame.Position
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={LocalPlayer.Character,Camera}
    rp.IgnoreWater=true
    local r=workspace:Raycast(o,part.Position-o,rp)
    if not r then return true end
    return r.Instance:IsDescendantOf(part.Parent)
end

local function target()
    local best,bd=nil,cfg.fov
    local ce=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    local myteam=LocalPlayer.Team
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        if cfg.team_check and p.Team==myteam then continue end
        local c=p.Character
        if not c then continue end
        local pt=c:FindFirstChild(cfg.hitbox)
        if not pt or not pt:IsA("BasePart") then continue end
        local h=c:FindFirstChildOfClass("Humanoid")
        if not h then continue end
        if cfg.dead_check and h.Health<=0 then continue end
        local pos,on=Camera:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d=(Vector2.new(pos.X,pos.Y)-ce).Magnitude
        if d>cfg.fov then continue end
        if not vis(pt) then continue end
        if d<bd then best,bd=pt,d end
    end
    return best
end

local function aim(t)
    local ap=t.Position+t.AssemblyLinearVelocity*cfg.prediction
    local ok,desired=pcall(function() return CFrame.lookAt(Camera.CFrame.Position,ap) end)
    if not ok then return end
    if cfg.smoothness<=1 then
        Camera.CFrame=desired
    else
        local alpha=1/cfg.smoothness
        if alpha>1 then alpha=1 end
        Camera.CFrame=Camera.CFrame:Lerp(desired,alpha)
    end
end

function K.update_aim()
    if cfg.fov_visible and K.fov_circle then
        K.fov_circle.Position=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
        K.fov_circle.Radius=cfg.fov; K.fov_circle.Visible=true
    elseif K.fov_circle then
        K.fov_circle.Visible=false
    end
    if not cfg.aim_enabled then return end
    local t=target()
    if t then aim(t) end
end

function K.uncuff()
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("cuff") or n:find("algema") or n:find("rope") or n:find("tie") then
            if obj:IsA("BasePart") then obj.Transparency = 1 end
            if obj:IsA("Accessory") or obj:IsA("Model") then obj:Destroy() end
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = 16; hum.JumpPower = 50 end
end

local held_car = nil
local car_pos = nil
local last_car_part = nil
local car_prompt_text = Drawing.new("Text")

car_prompt_text.Size = 16
car_prompt_text.Center = true
car_prompt_text.Outline = true
car_prompt_text.Color = Color3.fromRGB(255, 0, 0)
car_prompt_text.Visible = false

local function get_closest_car()
    local closest, dist = nil, 100
    local my_char = LocalPlayer.Character
    local hrp = my_char and my_char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChildWhichIsA("VehicleSeat") then
            local primary = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if primary then
                local d = (primary.Position - hrp.Position).Magnitude
                if d < dist then 
                    closest = v
                    dist = d 
                end
            end
        end
    end
    return closest
end

function K.toggle_grab_car()
    if held_car then
        -- Jogar Carro
        if car_pos then car_pos:Destroy() car_pos = nil end
        if last_car_part and last_car_part.Parent then
            pcall(function() last_car_part:SetNetworkOwner(nil) end)
            local vel = Instance.new("BodyVelocity")
            vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            vel.Velocity = Camera.CFrame.LookVector * 300 + Vector3.new(0, 150, 0)
            vel.Parent = last_car_part
            task.delay(0.3, function() if vel then vel:Destroy() end end)
        end
        held_car = nil
        last_car_part = nil
    else
        -- Pegar Carro
        local car = get_closest_car()
        if car then
            local primary = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
            if primary then
                held_car = car
                last_car_part = primary
                pcall(function() primary:SetNetworkOwner(LocalPlayer) end)
                
                for _, v in ipairs(primary:GetChildren()) do
                    if v:IsA("BodyPosition") or v:IsA("BodyVelocity") then
                        v:Destroy()
                    end
                end
                
                car_pos = Instance.new("BodyPosition")
                car_pos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                car_pos.P = 50000
                car_pos.D = 1000
                car_pos.Parent = primary
            end
        end
    end
end

function K.update_car()
    if held_car and car_pos then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            car_pos.Position = hrp.Position + Vector3.new(0, 15, 0)
        end
    end
    
    local car = get_closest_car()
    if car and car.PrimaryPart and not held_car then
        local pos, on_screen = Camera:WorldToViewportPoint(car.PrimaryPart.Position + Vector3.new(0, 3, 0))
        if on_screen then
            local key = "Y"
            if Options and Options.GrabCarBind then key = Options.GrabCarBind.Value end
            car_prompt_text.Text = "["..tostring(key).."] Pegar Carro"
            car_prompt_text.Position = Vector2.new(pos.X, pos.Y)
            car_prompt_text.Visible = true
        else
            car_prompt_text.Visible = false
        end
    else
        car_prompt_text.Visible = false
    end
end
local fly=nil
function K.update_movement(dt)
    local c=LocalPlayer.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    
    if cfg.speed_bypass_enabled then
        h.WalkSpeed = 16
        if h.MoveDirection.Magnitude > 0 then
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local move = h.MoveDirection * cfg.speed_bypass_val * dt
                hrp.CFrame = hrp.CFrame + move
            end
        end
    else
        h.WalkSpeed = 16
    end

    if cfg.jump_enabled then h.UseJumpPower=true; h.JumpPower=cfg.jump_power
    else h.JumpPower=50 end
    for _,p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.CanCollide = not cfg.noclip end
    end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CanCollide = not cfg.noclip end

    if not hrp or not cfg.fly then
        if fly then fly:Destroy() fly=nil end
        return
    end
    if not fly or fly.Parent~=hrp then
        if fly then fly:Destroy() end
        fly=Instance.new("BodyVelocity")
        fly.MaxForce=Vector3.new(1e5,1e5,1e5); fly.Velocity=Vector3.zero; fly.Parent=hrp
    end
    local d=Vector3.zero
    local cc=Camera.CFrame
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then d+=cc.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then d-=cc.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then d-=cc.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then d+=cc.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d+=Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then d-=Vector3.new(0,1,0) end
    if d.Magnitude>0 then d=d.Unit end
    fly.Velocity=d*cfg.fly_speed
end

