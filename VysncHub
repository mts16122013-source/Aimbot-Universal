local function create_esp(player)
    if player==LocalPlayer or esp_objects[player] then return end
    local o={}
    o.line=cd("Line",{Thickness=1,Color=Color3.fromRGB(255,255,255),Transparency=0.8,Visible=false})
    o.box=cd("Square",{Thickness=1,Color=Color3.fromRGB(255,255,255),Filled=false,Transparency=0.7,Visible=false})
    o.hp_bg=cd("Square",{Filled=true,Color=Color3.fromRGB(35,35,35),Transparency=0.7,Visible=false})
    o.hp_fill=cd("Square",{Filled=true,Color=Color3.fromRGB(0,220,80),Transparency=0.9,Visible=false})
    o.name=cd("Text",{Size=14,Center=true,Outline=true,Color=Color3.fromRGB(255,255,255),Visible=false})
    o.display=cd("Text",{Size=12,Center=true,Outline=true,Color=Color3.fromRGB(200,200,200),Visible=false})
    o.distance=cd("Text",{Size=12,Center=true,Outline=true,Color=Color3.fromRGB(180,180,255),Visible=false})
    o.weapon=cd("Text",{Size=12,Center=true,Outline=true,Color=Color3.fromRGB(255,200,0),Visible=false})
    o.inventory=cd("Text",{Size=11,Center=true,Outline=true,Color=Color3.fromRGB(255,140,80),Visible=false})
    o.skeleton={}
    for i=1,20 do o.skeleton[i]=cd("Line",{Thickness=1,Color=Color3.fromRGB(255,255,255),Transparency=0.8,Visible=false}) end
    esp_objects[player]=o
end

local skel_r15={
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"LowerTorso","HumanoidRootPart"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local skel_r6={
    {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"}
}

local function equipped(c)
    for _,h in ipairs({"RightHand","LeftHand"}) do
        local hd=c:FindFirstChild(h)
        if hd then for _,ch in ipairs(hd:GetChildren()) do if ch:IsA("Tool") then return ch.Name end end end
    end
    for _,ch in ipairs(c:GetChildren()) do if ch:IsA("Tool") then return ch.Name end end
    return nil
end

local function inv(p,c)
    local t={}
    for _,ch in ipairs(c:GetChildren()) do if ch:IsA("Tool") then table.insert(t,"[eq] "..ch.Name) end end
    local bp=p:FindFirstChildOfClass("Backpack")
    if bp then for _,ch in ipairs(bp:GetChildren()) do if ch:IsA("Tool") then table.insert(t,ch.Name) end end end
    return t
end

local function fullbox(c,head,hrp)
    local hp,hon=Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
    if not hon then return nil end
    local rp,ron=Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
    if not ron then return nil end
    local h = rp.Y - hp.Y
    if h <= 0 then h = 100 end
    local w = h * 0.55
    return Vector2.new(hp.X - w/2, hp.Y), w, h
end

local function hide(o)
    o.line.Visible=false; o.box.Visible=false
    o.hp_bg.Visible=false; o.hp_fill.Visible=false
    o.name.Visible=false; o.display.Visible=false
    o.distance.Visible=false; o.weapon.Visible=false; o.inventory.Visible=false
    for _,l in ipairs(o.skeleton) do l.Visible=false end
end

function K.update_esp()
    for player in pairs(esp_objects) do
        if not player.Parent then K.remove_esp(player) end
    end

    local ss=Camera.ViewportSize
    local top=Vector2.new(ss.X/2,0)
    local bot=Vector2.new(ss.X/2,ss.Y)
    local mid=Vector2.new(ss.X/2,ss.Y/2)
    local mc=LocalPlayer.Character
    local mh=mc and mc:FindFirstChild("HumanoidRootPart")
    local any=cfg.esp_line or cfg.esp_skeleton or cfg.esp_box or cfg.esp_health
        or cfg.esp_name or cfg.esp_display or cfg.esp_weapon or cfg.esp_distance or cfg.esp_inventory
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        if not any then
            if esp_objects[p] then hide(esp_objects[p]) end
            continue
        end
        if not esp_objects[p] then create_esp(p) end
        local o=esp_objects[p]
        local c=p.Character
        if not c then hide(o) continue end
        local hrp=c:FindFirstChild("HumanoidRootPart")
        local head=c:FindFirstChild("Head")
        local hum=c:FindFirstChildOfClass("Humanoid")
        if not hrp or not head or not hum or hum.Health<=0 then hide(o) continue end
        local rp,ron=Camera:WorldToViewportPoint(hrp.Position)
        local hp,hon=Camera:WorldToViewportPoint(head.Position)
        if not ron and not hon then hide(o) continue end
        local sr=Vector2.new(rp.X,rp.Y)
        local sh=Vector2.new(hp.X,hp.Y)
        if cfg.esp_line then
            local ori=top
            if cfg.esp_line_origin=="bottom" then ori=bot
            elseif cfg.esp_line_origin=="center" then ori=mid end
            o.line.From=ori; o.line.To=sr; o.line.Visible=true
        else o.line.Visible=false end
        
        local bl,bw,bh
        if cfg.esp_box or cfg.esp_health then bl,bw,bh=fullbox(c,head,hrp) end
        
        if cfg.esp_box and bl then
            o.box.Size=Vector2.new(bw,bh); o.box.Position=bl; o.box.Visible=true
        else o.box.Visible=false end
        if cfg.esp_health and bl then
            local r=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local bx=bl.X-7
            o.hp_bg.Size=Vector2.new(3,bh); o.hp_bg.Position=Vector2.new(bx,bl.Y); o.hp_bg.Visible=true
            o.hp_fill.Size=Vector2.new(3,bh*r); o.hp_fill.Position=Vector2.new(bx,bl.Y+bh*(1-r))
            o.hp_fill.Color=Color3.fromRGB(math.floor(255*(1-r)),math.floor(220*r),60)
            o.hp_fill.Visible=true
        else o.hp_bg.Visible=false; o.hp_fill.Visible=false end
        if cfg.esp_distance and mh then
            o.distance.Text=string.format("%d m",math.floor((mh.Position-hrp.Position).Magnitude))
            o.distance.Position=Vector2.new(sh.X,sh.Y-38); o.distance.Visible=true
        else o.distance.Visible=false end
        if cfg.esp_name then
            o.name.Text="@"..p.Name; o.name.Position=Vector2.new(sh.X,sh.Y-22); o.name.Visible=true
        else o.name.Visible=false end
        if cfg.esp_display then
            o.display.Text=p.DisplayName; o.display.Position=Vector2.new(sh.X,sh.Y-6); o.display.Visible=true
        else o.display.Visible=false end
        if cfg.esp_weapon then
            local w=equipped(c)
            if w then o.weapon.Text=w; o.weapon.Position=Vector2.new(sh.X,sr.Y+22); o.weapon.Visible=true
            else o.weapon.Visible=false end
        else o.weapon.Visible=false end
        if cfg.esp_inventory then
            local it=inv(p,c)
            if #it>0 then
                local s={}
                for i=1,math.min(#it,6) do table.insert(s,it[i]) end
                local txt=table.concat(s," | ")
                if #it>6 then txt=txt.." +"..(#it-6) end
                o.inventory.Text=txt; o.inventory.Position=Vector2.new(sh.X,sr.Y+36); o.inventory.Visible=true
            else o.inventory.Visible=false end
        else o.inventory.Visible=false end
        
        if cfg.esp_skeleton then
            local skel = c:FindFirstChild("UpperTorso") and skel_r15 or skel_r6
            local i=1
            for _,cn in ipairs(skel) do
                local p1=c:FindFirstChild(cn[1]); local p2=c:FindFirstChild(cn[2])
                if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                    local s1,o1=Camera:WorldToViewportPoint(p1.Position)
                    local s2,o2=Camera:WorldToViewportPoint(p2.Position)
                    if o1 and o2 and i<=#o.skeleton then
                        local l=o.skeleton[i]
                        l.From=Vector2.new(s1.X,s1.Y); l.To=Vector2.new(s2.X,s2.Y); l.Visible=true
                        i=i+1
                    end
                end
            end
            for j=i,#o.skeleton do o.skeleton[j].Visible=false end
        else for _,l in ipairs(o.skeleton) do l.Visible=false end end
    end
end
